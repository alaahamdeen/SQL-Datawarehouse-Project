/*
==============================================================
Loading data using BULK INSER & making Stored Procedure
==============================================================
In this script I : 
    1. Add data using BULK INSERT.
    2. Make a stored procedure to refresh data in staging tables.
*/

create procedure bronze.loaded_bronze as 

